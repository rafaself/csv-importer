{
  "name": "@csv/database",
  "version": "1.0.0",
  "description": "",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-source": {
      "types": "./dist/data-source.d.ts",
      "import": "./dist/data-source.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d src/data-source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@csv/shared": "workspace:*",
    "@csv/config": "workspace:*",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "ts-node": "10.9.2",
    "typescript": "^6.0.3"
  }
}
